# -------------------------------------------------------------
# Database configuration
# -------------------------------------------------------------
# <DB_USER> : username for connecting to the PostgreSQL database
# <DB_PASSWORD> : password for connecting to the PostgreSQL database
# <DB_NAME> : name of the PostgreSQL database
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=<DB_NAME>

# JWT secret used for signing tokens
# <JWT_SECRET> : replace with a strong random secret for production
JWT_SECRET=<JWT_SECRET>


# -------------------------------------------------------------
# Backend server ports
# -------------------------------------------------------------
# <INTERNAL_PORT> : the port Spring Boot listens to inside the Docker container (server.port)
# <EXTERNAL_PORT> : the port exposed on the host machine (docker-compose host_port)
SERVER_PORT_INTERNAL=<INTERNAL_PORT>
SERVER_PORT_EXTERNAL=<EXTERNAL_PORT>