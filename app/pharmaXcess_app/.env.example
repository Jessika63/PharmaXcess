# -------------------------------------------------------------
# Backend API URLs
# -------------------------------------------------------------
# <YOUR_LOCAL_WIFI_LAN_IP> : your machine's local IP on Wi-Fi/LAN network
# <PORT> : the backend external host port (SERVER_PORT_EXTERNAL)
API_URL_DEV=http://<YOUR_LOCAL_WIFI_LAN_IP>:<PORT>

# Production backend API
API_URL=https://api.monsite.com


# -------------------------------------------------------------
# Map Tile Provider
# -------------------------------------------------------------
# <MAP_TILE_URL> : URL template for your map tile provider.
#   - Must include placeholders {z}/{x}/{y} for zoom and tile coordinates.
#   - Some providers also require a {s} placeholder for subdomains (e.g., a/b/c).
#   - If an API key is needed, append it as a query parameter (e.g., ?key=YOUR_API_KEY).
#
# Examples:
#   MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_API_KEY
#
# IMPORTANT: Do NOT use OSM’s default tile server (tile.openstreetmap.org) in production.
#   Use a provider (MapTiler, Mapbox, Carto, etc.) or host your own tile server.
#
MAP_TILE_URL=<MAP_TILE_URL>